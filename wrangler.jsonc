{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ekayn-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ekayn-web"
    }
  ],

  "observability": {
    "enabled": true
  }
}
